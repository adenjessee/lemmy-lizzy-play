    "dialog": [
     {
      "who": "Hornbill",
      "lines": "Well hello, small friends! You followed me far.\nYou're braver than most little critters are!"
     },
     {
      "who": "Lemmy",
      "lines": "We're bored of seeds and bored of bugs!\nWe want a snack that's worth big hugs!"
     },
     {
      "who": "Hornbill",
      "lines": "Then listen close, I'll tell you true:\nthe Tastiest Fruit is waiting for you."
     },
     {
      "who": "Hornbill",
      "lines": "It grows on the mountain, way up high,\nwhere misty clouds go drifting by."
     },
     {
      "who": "Hornbill",
      "lines": "But the sea is rising, day by day…\nso hurry along, be on your way!"
     },
     {
      "who": "Lizzy",
      "lines": "The Tastiest Fruit! Oh Lemmy, let's go!\nThrough jungle and river, through high and low!"
